# FareBuddy environment
# Leave these blank to run in local demo mode (data persists in this browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only — used by `npm run seed:supabase`. Never expose publicly and
# never prefix with VITE_ (Vite would bundle it into the browser app).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
